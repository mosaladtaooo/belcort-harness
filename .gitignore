# Nothing user-specific should ever land in this repo.

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Installer artifacts
.harness-backup-*/

# Local snapshots taken during refactor phases (do not ship)
plugins.*.bak*/
templates.*.bak*/
*.bak-[0-9]*/

# Claude Code local settings / transient session files
.claude/

# Don't accidentally commit a runtime .harness/ if testing locally
.harness/

# Secrets
.env
.env.*
*.key
*.pem

# Project-internal artifacts that shouldn't ship in the public plugin repo
# (e.g., improvement reports from downstream consumer projects dropped at root)
/# BELCORT Harness*Improvement Report*.txt
